# ── HuggingFace ───────────────────────────────────────────────────────────────
# Get your token at https://huggingface.co/settings/tokens
# Required for faster downloads and gated models (e.g. SDXL)
HF_TOKEN=

# ── Coqui TTS ─────────────────────────────────────────────────────────────────
# Auto-agrees to Coqui TOS so XTTS-v2 downloads without prompting
COQUI_TOS_AGREED=1

# ── PyTorch / MPS ─────────────────────────────────────────────────────────────
# Allows MPS (Apple M2) to fall back to CPU for unsupported ops (e.g. SadTalker)
PYTORCH_ENABLE_MPS_FALLBACK=1

# ── Server ────────────────────────────────────────────────────────────────────
# Override default host/port without editing config.yaml
# HOST=0.0.0.0
# PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
